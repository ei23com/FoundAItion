# ─── Server ────────────────────────────────────────────────
LISTEN_PORT=8080
DB_FILE=./foundaition.db
UI_LANGUAGE=de

# ─── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=http://10.1.1.11:4000/v1
OPENAI_MODELS="summarizer, image_model, fast_coder"
OPENAI_MODEL=summarizer
SUMMARY_MAX_TOKENS=64000
# Wie viele Token das Modell pro Antwort erzeugen darf. Zu kleine Werte
# schneiden die Zusammenfassung ab (finish_reason "length"); sie wird dann
# automatisch fortgesetzt (bis zu 3 Runden) und, falls es noch nicht reicht,
# sichtbar als abgeschnitten markiert.
SUMMARY_MAX_OUTPUT_TOKENS=8192
AUTO_SUMMARIZE=true
# HTTP-Timeout für LLM-Aufrufe (Zusammenfassung + Embeddings) in Sekunden.
# Minimum 240 s: lokale Modellserver laden ein Modell erst beim ersten Aufruf,
# das kann mehrere Minuten dauern. Kleinere Werte werden auf 240 angehoben.
LLM_TIMEOUT=240

# ─── Whisper ──────────────────────────────────────────────
WHISPER_URL=http://localhost:8081
WHISPER_MODEL=whisper
WHISPER_API_KEY=sk-...

# ─── Crawling ─────────────────────────────────────────────
CRAWL_TIMEOUT=60

# ─── YouTube / yt-dlp ─────────────────────────────────────
YTDLP_PATH=./yt-dlp_linux
YOUTUBE_SUBTITLE_METHOD=auto
# Bevorzugte Untertitelsprachen in Prioritätsreihenfolge (yt-dlp-Muster).
# Kurze Codes werden zu Präfixmustern ("en" → "en.*"). Für jede Sprache werden
# zuerst exakter Code und "-orig"-Spur angefragt ("en,en-orig"), nur wenn das
# nichts liefert, folgen die breiten Muster – das schont YouTubes Ratelimit.
# NIEMALS ".*-orig" setzen: das lädt jede Original-Spur (bei englischen Videos
# oft Arabisch).
YTDLP_SUB_LANGS=en.*,de.*
# Zielverzeichnis des manuellen Helfers "yt-sub" (SRT + konvertiertes Transkript)
YT_SUBS_DIR=./subs

# ─── RSS Feed ─────────────────────────────────────────────
RSS_BASE_URL=
RSS_ITEM_COUNT=30
RSS_EXTRA_ACTION_LINK=

# ─── Processing ───────────────────────────────────────────
MAX_PROCESS_DAYS=14
CATEGORIZE_MODEL=fast_coder
# ─── Vectormap / Embeddings ───────────────────────────────
# Leer lassen für den lokalen Hash-Embedder (offline, deterministisch).
# Für semantische Karten: OpenAI-kompatibler /embeddings-Endpunkt, z.B.
# ein eigener llama.cpp-Server mit Qwen3-Embedding-0.6B-GGUF:
#   ./llama-server -m qwen3-embedding-0.6b.gguf --port 9293 \
#     --n-gpu-layers 99 --pooling embed
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
